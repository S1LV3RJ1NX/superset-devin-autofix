# Copy this file to .env and fill in values locally. Never commit .env.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai

# Required for GitHub webhook authentication.
GITHUB_WEBHOOK_SECRET=

# Required for operator access to GET /jobs and development POST /simulate.
CONTROL_PLANE_API_KEY=

# Reserved for future GitHub status updates.
GITHUB_TOKEN=

# Application configuration
APP_ENV=production
DATABASE_PATH=/data/control-plane.sqlite3
TARGET_REPOSITORY=S1LV3RJ1NX/superset
AUTOFIX_LABEL=devin-autofix
POLL_INTERVAL_SECONDS=10
SESSION_TIMEOUT_SECONDS=3600
WORKER_ENABLED=true
